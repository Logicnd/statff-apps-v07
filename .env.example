# Required — Application Logs webhook (embeds work with this alone)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE/REPLACE

# Optional — real interactive buttons (Interview / Reviewing / Hold / Deny)
# Create a Discord Application → Bot → copy token; invite bot to the server
# with Send Messages + Use Components permissions in the logs channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Same app → General Information → Public Key
# Interactions Endpoint URL: https://YOUR-DEPLOY.vercel.app/api/interactions
DISCORD_PUBLIC_KEY=
